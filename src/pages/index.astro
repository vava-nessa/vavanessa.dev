---
/**
 * @file Coming Soon homepage.
 * @description
 * 📖 Temporary landing page while the site is under construction.
 * The real site is accessible at /website/* via Vercel rewrites.
 * When ready to launch: restore original index.astro content and
 * remove redirects/rewrites from vercel.json.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>vavanessa.dev</title>
    <meta name="description" content="Vanessa Depraute — developer, builder, writer. Coming soon." />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@400;500&display=swap");

      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --paper: #f7f0e4;
        --ink: #2c2824;
        --ink-muted: #7a7060;
        --cinnabar: #a8432a;
        --glow: rgba(168, 67, 42, 0.08);
      }

      html {
        background: var(--paper);
        color: var(--ink);
        font-family: "Inter", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(circle at top left, var(--glow), transparent 28rem);
      }

      .name {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(3rem, 8vw, 5.5rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1;
        color: var(--ink);
      }

      .tagline {
        margin-top: 1.25rem;
        font-size: clamp(1rem, 2.5vw, 1.15rem);
        color: var(--ink-muted);
        line-height: 1.6;
        max-width: 28rem;
      }

      .status {
        margin-top: 2.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--cinnabar);
      }

      .status::before {
        content: "";
        display: block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--cinnabar);
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      .footer-note {
        position: absolute;
        bottom: 1.5rem;
        font-size: 0.75rem;
        color: var(--ink-muted);
        opacity: 0.6;
      }
    </style>
  </head>
  <body>
    <h1 class="name">vavanessa.dev</h1>
    <p class="tagline">
      Build notes, open-source projects, and practical essays&nbsp;from a
      full-stack developer building in public.
    </p>
    <p class="status">Coming soon</p>
    <p class="footer-note">Vanessa Depraute</p>
  </body>
</html>
