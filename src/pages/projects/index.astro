---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortProjectsByOrder } from "@/lib/content";

/**
 * @file Projects index page.
 * @description
 * 📖 Lists all project collection entries with status, stack, and links to rich
 * detail pages. Later phases can add live GitHub and npm metadata here.
 *
 * @exports ProjectsIndexPage
 */

const projects = sortProjectsByOrder(await getCollection("projects"));
---

<BaseLayout title="Projects" description="Open-source projects, tools, and product experiments by Vanessa Depraute.">
  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-cinnabar">Projects</p>
    <h1 class="mt-4 font-serif text-6xl font-semibold">Tools, experiments, and launches.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-ink-muted">
      A living index of open-source work and product ideas. Rich demos will be added project by project.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-5 pb-16 md:grid-cols-2">
    {projects.map((project) => (
      <article class="border border-ink/10 bg-paper-soft p-6">
        <a href={`/projects/${project.slug}`} class="no-underline">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-cinnabar">{project.data.status}</p>
          <h2 class="mt-3 font-serif text-4xl font-semibold">{project.data.name}</h2>
          <p class="mt-3 text-sm leading-6 text-ink-muted">{project.data.tagline}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.data.stack.map((item) => <span class="rounded-full bg-wash px-3 py-1 text-xs text-ink-muted">{item}</span>)}
          </div>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
