---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { filterPublishedPosts, getUniqueTags, sortPostsByDate } from "@/lib/content";

/**
 * @file Blog tag archive route.
 * @description
 * 📖 Builds one static archive page for each tag used by published posts.
 *
 * @functions
 * - getStaticPaths → Creates tag archive routes from collection metadata.
 * @exports BlogTagPage
 */

export async function getStaticPaths() {
  const posts = filterPublishedPosts(await getCollection("posts"));
  return getUniqueTags(posts).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: sortPostsByDate(posts.filter((post) => post.data.tags.includes(tag)))
    }
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag} on vavanessa.dev.`}>
  <section class="mx-auto max-w-5xl px-5 py-16">
    <a href="/blog" class="text-sm text-ink-muted">Back to blog</a>
    <h1 class="mt-6 font-serif text-6xl font-semibold">#{tag}</h1>
  </section>
  <section class="mx-auto grid max-w-5xl gap-6 px-5 pb-16">
    {posts.map((post) => (
      <article class="border-t border-ink/10 pt-6">
        <a href={`/blog/${post.slug}`} class="no-underline">
          <h2 class="font-serif text-4xl font-semibold">{post.data.title}</h2>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-ink-muted">{post.data.description}</p>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
