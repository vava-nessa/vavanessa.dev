---
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * @file About page.
 * @description
 * 📖 Placeholder personal page for phase 1. The identity details can be expanded
 * after the exact balance between developer, iOS, and medical background is set.
 *
 * @exports AboutPage
 */
---

<BaseLayout title="About" description="About Vanessa Depraute and the purpose of vavanessa.dev.">
  <section class="mx-auto max-w-3xl px-5 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-cinnabar">About</p>
    <h1 class="mt-4 font-serif text-6xl font-semibold">Vanessa Depraute</h1>
    <div class="prose-content mt-8">
      <p>
        Vanessa is a full-stack and iOS developer building open-source tools, product experiments, and practical software notes in public.
      </p>
      <p>
        This page will become the narrative version of the professional profile: less formal than the CV, more useful for people discovering the projects through the blog or social channels.
      </p>
    </div>
  </section>
</BaseLayout>
