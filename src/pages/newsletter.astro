---
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * @file Newsletter placeholder page.
 * @description
 * 📖 Reserves the route requested by the PRD without pretending the provider has
 * already been selected. The real form belongs to the deferred newsletter phase.
 *
 * @exports NewsletterPage
 */
---

<BaseLayout title="Newsletter" description="Newsletter signup placeholder for vavanessa.dev.">
  <section class="mx-auto max-w-3xl px-5 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-cinnabar">Newsletter</p>
    <h1 class="mt-4 font-serif text-6xl font-semibold">Not wired yet.</h1>
    <p class="mt-6 text-lg leading-8 text-ink-muted">
      The newsletter provider will be chosen in a later phase. Until then, RSS is the best way to follow new posts.
    </p>
    <a href="/rss.xml" class="mt-8 inline-block rounded-full bg-ink px-5 py-3 text-sm font-medium text-paper-soft no-underline">Subscribe via RSS</a>
  </section>
</BaseLayout>
